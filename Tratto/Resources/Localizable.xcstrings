          }
        }
      }
    },
    "Tratto": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratto"
          }
        }
      }
    },
    "Tratto lays out alternating blocks of days, with a gap between them, and randomises the order inside each pair.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratto dispone blocchi di giorni alternati, con una pausa fra l'uno e l'altro, e sorteggia l'ordine dentro ogni coppia."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratto lays out alternating blocks of days, with a gap between them, and randomises the order inside each pair."
          }
        }
      }
    },
    "Tratto never tells you that a food is causing your symptoms.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratto non ti dirà mai che un alimento è la causa dei tuoi sintomi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratto never tells you that a food is causing your symptoms."
          }
        }
      }
    },
    "Tratto records what you enter and counts it. It is not a medical device, it does not diagnose, and it does not replace a clinician.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratto registra quello che scrivi e ne mostra il conteggio. Non è un dispositivo medico, non formula diagnosi e non sostituisce il parere di un medico."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratto records what you enter and counts it. It is not a medical device, it does not diagnose, and it does not replace a clinician."
          }
        }
      }
    },
    "Tratto records what you enter and shows counts and summaries of it. It does not link foods to symptoms, and it will not: on the numbers a personal diary produces, such a link could not be told apart from chance. It is not a medical device, it does not diagnose, and it does not replace a clinician. Talk to a doctor or a dietitian before changing what you eat.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratto registra quello che inserisci e ne mostra ricorrenze e riepiloghi. Non mette in relazione gli alimenti con i sintomi e non lo farà: sui numeri che un diario personale produce, una relazione del genere non sarebbe distinguibile dal caso. Non è un dispositivo medico, non formula diagnosi e non sostituisce il parere di un medico. Parla con un medico o con un dietista prima di cambiare la tua alimentazione."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratto records what you enter and shows counts and summaries of it. It does not link foods to symptoms, and it will not: on the numbers a personal diary produces, such a link could not be told apart from chance. It is not a medical device, it does not diagnose, and it does not replace a clinician. Talk to a doctor or a dietitian before changing what you eat."
          }
        }
      }
    },
    "Two days %lld days apart no longer resemble each other appreciably. That is the number a washout between two conditions would have to respect.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due giorni distanti %lld giorni non si somigliano più in modo apprezzabile. È il numero che una pausa fra due condizioni dovrebbe rispettare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two days %lld days apart no longer resemble each other appreciably. That is the number a washout between two conditions would have to respect."
          }
        }
      }
    },
    "Typical difference": {
      "localizations": {
