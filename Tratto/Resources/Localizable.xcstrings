    "%@ Recognition still works by matching your text against the catalogue.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Il riconoscimento funziona lo stesso, confrontando quello che scrivi con il catalogo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Recognition still works by matching your text against the catalogue."
          }
        }
      }
    },
