    "Coverage over the last 7 days is %@. Below 70%% a period is not analysable, because most days are not observed but only partly known.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Negli ultimi 7 giorni la copertura è %@. Sotto il 70%% un periodo non è analizzabile, perché la maggior parte delle giornate non è osservata ma solo in parte nota."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coverage over the last 7 days is %@. Below 70%% a period is not analysable, because most days are not observed but only partly known."
          }
        }
      }
    },
